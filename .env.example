# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real credentials.

# Supabase project (see src/services/supabaseConfig.ts). Required — the app
# throws on boot without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_KEY=

# FastAPI backend base URL (see src/services/api.ts). Defaults to
# http://127.0.0.1:8787 (local dev) if unset.
NEXT_PUBLIC_FASTAPI_BASE=

# tripagent-site-main (the customer-facing site) base URL — see
# proposalTemplateData.ts's hotelUrl(). A hotel name/photo clicked in a
# Proposal PDF/preview must land here, not on this admin panel's own origin.
# Local dev value is tripagent-site-main/app's own Vite dev server port.
# Defaults to the real production domain (https://tripagent-site-orpin.vercel.app)
# if unset.
NEXT_PUBLIC_SITE_BASE_URL=

# tripagent-site-main's own BACKEND base URL (see src/services/api.ts's
# SITE_API_BASE) — a separate thing from NEXT_PUBLIC_SITE_BASE_URL above
# (that one's the site's FRONTEND). Used by the Admin Panel's Phase C
# access-request review screen. Defaults to http://localhost:8000 (local
# dev) if unset. Read server-side only now (by
# src/app/api/site-admin/[...path]/route.ts) — kept NEXT_PUBLIC_-prefixed
# only because nothing else needs it hidden; it's a base URL, not a secret.
NEXT_PUBLIC_SITE_API_BASE=

# Server-only shared secret for the access-request review endpoints on
# tripagent-site-main's backend (GET /access-requests/pending, POST
# /access-requests/{id}/approve, POST /access-requests/{id}/deny) — must
# match that backend's own ADMIN_API_KEY exactly. Deliberately NOT
# NEXT_PUBLIC_-prefixed: Next.js only inlines NEXT_PUBLIC_* vars into the
# browser bundle, and this one must never reach the browser. Read only by
# src/app/api/site-admin/[...path]/route.ts (a server-side Route Handler),
# which attaches it as the X-Admin-Key header when proxying AdminPanel.tsx's
# calls. Unset means every one of those 3 calls is refused with 500 (fails
# closed, never open) — generate a real random value per environment and
# set it directly in that environment's secret store; never commit an
# actual value here. This is a shared secret, not per-admin identity — see
# that route handler's own note on the tradeoff.
ADMIN_API_KEY=

# development | production — see src/lib/env.ts. Controls dev-only UI
# convenience (currently: the sign-in screen's Autofill button). Never
# bypasses auth or swaps a real API call for fake data. Set to "production"
# in every real deployment.
NEXT_PUBLIC_APP_ENV=development

# Dev-only: a real, already-provisioned advisor login for the sign-in
# screen's Autofill button. Only takes effect when NEXT_PUBLIC_APP_ENV=
# development. Leave blank to hide the button.
NEXT_PUBLIC_DEV_AUTOFILL_EMAIL=
NEXT_PUBLIC_DEV_AUTOFILL_PASSWORD=
